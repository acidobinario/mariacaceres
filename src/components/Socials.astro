---
import { site } from '../data/site';
---

<section aria-labelledby="socials-heading">
  <div class="wrap">
    <h2 id="socials-heading">Síguela</h2>
    <div class="cards stagger">
      {
        site.socials.map((social) => (
          <a
            class:list={[
              'card',
              'soc-card',
              'reveal',
              { 'card-primary': social.kind === 'tips' },
              `card-${social.kind}`,
            ]}
            href={social.url}
            target="_blank"
            rel="noopener"
          >
            {social.kind === 'instagram' && (
              <svg
                class="soc-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none" />
              </svg>
            )}
            {social.kind === 'linktree' && (
              <svg
                class="soc-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 22V4M12 9 6.8 3.8M12 9l5.2-5.2M12 15l-5.2-5.2M12 15l5.2-5.2" />
              </svg>
            )}
            {social.kind === 'tips' && (
              <svg class="soc-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
            )}
            <span class="label">{social.label}</span>
            <span class="visually-hidden">
              {social.kind === 'tips' ? '(aportar)' : `(${social.label} de ${site.artist})`}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 1rem;
  }

  .soc-card {
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: clamp(9rem, 18vw, 12rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .soc-icon {
    width: clamp(1.75rem, 3vw, 2.25rem);
    height: clamp(1.75rem, 3vw, 2.25rem);
  }

  .label {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-align: left;
  }

  .card-tips .label {
    text-align: left;
  }

  @media (min-width: 48em) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }

    .card-tips {
      grid-column: 1 / -1;
    }
  }
</style>
