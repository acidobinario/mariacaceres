---
type IconName =
  | 'spotify'
  | 'apple'
  | 'youtube'
  | 'heart'
  | 'instagram'
  | 'linktree'
  | 'arrow'
  | 'menu'
  | 'close';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'icon' } = Astro.props;

const fillIcons: Record<string, string> = {
