---
import { site } from '../data/site';

const year = new Date(site.single.releaseDate).getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="copy">© {year} {site.artist}</p>
    <p class="footnote">“{site.single.title}” · Single</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding-block: 2.5rem 3.25rem;
  }

  p {
    margin: 0;
  }

  .copy {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footnote {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--muted);
  }
</style>
