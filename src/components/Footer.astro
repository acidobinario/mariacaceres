---
import { site } from '../data/site';
---

<footer>
  <div class="wrap">
    <p class="wordmark reveal" aria-hidden="true">{site.artist}</p>
    <p class="copyright">© 2026 {site.artist}</p>
  </div>
</footer>

<style>
  footer {
    padding: clamp(3rem, 8vw, 6rem) 0 2.25rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 12vw, 10.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .copyright {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
