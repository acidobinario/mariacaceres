---
import Icon from './Icon.astro';
import { site } from '../data/site';

const nav = [
  { label: 'Música', href: '#musica' },
  { label: 'Videos', href: '#videos' },
  { label: 'Biografía', href: '#biografia' },
  { label: 'Apóyame', href: '#apoyame' },
];
const instagram = site.socials.find((item) => item.kind === 'instagram');
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <a class="wordmark" href="#top">{site.artist}</a>
    <nav class="site-nav" aria-label="Secciones">
      {
        nav.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-socials">
      {
        instagram && (
          <a href={instagram.url} target="_blank" rel="noopener">
            <span class="visually-hidden">Instagram de {site.artist}</span>
            <Icon name="instagram" />
          </a>
        )
      }
      <a href={site.youtube.url} target="_blank" rel="noopener">
        <span class="visually-hidden">Canal de YouTube de {site.artist}</span>
        <Icon name="youtube" />
      </a>
    </div>
    <button
      class="menu-button"
      id="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="menu-overlay"
    >
      <span class="visually-hidden menu-label">Abrir menú</span>
      <Icon name="menu" class="icon-menu" />
      <Icon name="close" class="icon-close" />
    </button>
  </div>
</header>

<div class="menu-overlay" id="menu-overlay" hidden>
  <nav class="overlay-nav" aria-label="Secciones">
    {
      nav.map((item) => (
        <a href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="overlay-socials">
    {
      instagram && (
        <a href={instagram.url} target="_blank" rel="noopener">
          <Icon name="instagram" />
          Instagram
        </a>
      )
    }
    <a href={site.youtube.url} target="_blank" rel="noopener">
      <Icon name="youtube" />
      YouTube
    </a>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: rgb(11 11 12 / 0.84);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .site-nav {
    margin-left: auto;
    display: none;
    gap: 1.9rem;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--fg);
  }

  .header-socials {
    display: none;
    gap: 0.25rem;
    margin-left: 0.5rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
  }

  .header-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 0.5rem;
    color: var(--muted);
  }

  .header-socials a:hover {
    color: var(--fg);
    background: #1a1a1d;
  }

  .menu-button {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 0.5rem;
    background: none;
    color: var(--fg);
    cursor: pointer;
  }

  .menu-button svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .menu-button .icon-menu {
    display: block;
  }

  .menu-button .icon-close {
    display: none;
  }

  .menu-button.is-open .icon-menu {
    display: none;
  }

  .menu-button.is-open .icon-close {
    display: block;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-height) + 2rem) clamp(1.25rem, 6vw, 3rem) 2.5rem;
    background: rgb(11 11 12 / 0.97);
    opacity: 0;
  }

  .menu-overlay.is-open {
    opacity: 1;
  }

  .overlay-nav {
    display: flex;
    flex-direction: column;
  }

  .overlay-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-size: 2.4rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .overlay-socials {
    margin-top: auto;
    display: flex;
    gap: 1.25rem;
  }

  .overlay-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .overlay-socials a:hover {
    color: var(--fg);
  }

  @media (min-width: 861px) {
    .site-nav,
    .header-socials {
      display: flex;
    }

    .menu-button {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        background-color 0.3s ease,
        border-color 0.3s ease;
    }

    .menu-overlay {
      transition: opacity 0.25s ease;
    }
  }
</style>

<style is:inline>
  html:not(.js) .menu-button {
    display: none;
  }
  html:not(.js) .site-nav {
    display: flex;
    flex-wrap: wrap;
  }
</style>
