---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';

const release = site.releases[0];
const primaryLink =
  release.listen.find((item) => item.platform === 'more') ?? release.listen[0];
const secondaryLinks = release.listen.filter((item) => item.platform !== 'more');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-media">
      <Image
        class="cover"
        src={release.cover}
        alt={`Portada del single "${release.title}" de ${site.artist}`}
        widths={[480, 640, 800, 1000]}
        sizes="(min-width: 1024px) 42vw, (min-width: 640px) 55vw, calc(100vw - 2.5rem)"
        priority
      />
    </div>
    <div class="hero-copy">
      <p class="hero-kicker">Nuevo single</p>
      <h1 id="hero-title">“{release.title}”</h1>
      <p class="hero-meta">{release.type} · {release.year}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={primaryLink.url} target="_blank" rel="noopener">
          Escuchar
          <Icon name="arrow" />
        </a>
        {
          secondaryLinks.map((item) => (
            <a class="btn btn-ghost" href={item.url} target="_blank" rel="noopener">
              <Icon name={item.platform === 'spotify' ? 'spotify' : 'apple'} />
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 1.5rem 4rem;
  }

  .hero-inner {
    display: grid;
    gap: 2rem;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.65rem;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
    position: relative;
    z-index: 0;
  }

  .hero-media {
    position: relative;
    z-index: 1;
  }

  .hero-media::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--line-strong);
    border-radius: 0.65rem;
    transform: translate(14px, 14px);
    z-index: -1;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-kicker::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: var(--muted);
  }

  h1 {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.1rem, 9vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: 0.01em;
  }

  .hero-meta {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
  }

  .hero-actions {
    margin-top: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: calc(100svh - var(--header-height));
      display: flex;
      align-items: center;
      padding-block: 5.5rem;
    }

    .hero-inner {
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }

    .hero-media {
      order: 2;
      margin-left: clamp(-4rem, -3vw, 0rem);
    }

    .hero-copy {
      order: 1;
      position: relative;
      z-index: 2;
    }

    h1 {
      text-shadow: 0 2px 32px rgb(0 0 0 / 0.45);
    }
  }
</style>
