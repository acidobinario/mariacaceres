---
import { Image } from 'astro:assets';
import { site } from '../data/site';

const icons = {
  spotify:
    'M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.5 17.3c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14 4.32-1.32 9.72-.66 13.44 1.62.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z',
  apple:
    'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701',
  more: null,
} as const;
---

<section class="hero" id="inicio" aria-labelledby="hero-heading">
  <div class="hero-media">
    <Image
      class="cover"
      src={site.single.cover}
      alt={`Portada del single "${site.single.title}" de ${site.artist}`}
      widths={[480, 640, 800]}
      sizes="100vw"
      priority
    />
    <div class="scrim" aria-hidden="true"></div>
  </div>
  <div class="hero-content">
    <p class="artist">{site.artist}</p>
    <h1 id="hero-heading">{site.single.title}</h1>
    <p class="meta">Single · 2026</p>
    <div class="listen">
      <h2>Escúchala ahora</h2>
      <div class="buttons">
        {
          site.listen.map((item) => (
            <a
              class:list={['btn', { 'btn-primary': item.platform === 'spotify' }]}
              href={item.url}
              target="_blank"
              rel="noopener"
            >
              {item.platform === 'more' ? (
                <svg
                  class="icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c2.8 2.6 2.8 15.4 0 18M12 3c-2.8 2.6-2.8 15.4 0 18" />
                </svg>
              ) : (
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={icons[item.platform]} />
                </svg>
              )}
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding: 0 var(--pad) clamp(2rem, 6vh, 3.5rem);
    border-top: 0;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    filter: grayscale(1) contrast(1.05) brightness(0.92);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(10 10 11 / 0.6) 0%, rgb(10 10 11 / 0) 28%),
      linear-gradient(
        0deg,
        rgb(10 10 11 / 0.98) 0%,
        rgb(10 10 11 / 0.82) 20%,
        rgb(10 10 11 / 0.3) 52%,
        rgb(10 10 11 / 0) 74%
      );
  }

  .hero-content {
    position: relative;
    width: 100%;
  }

  .artist {
    margin: 0 0 1rem;
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    font-weight: 550;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(3.4rem, 13vw, 10rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .meta {
    margin: 1.1rem 0 0;
    color: var(--muted);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .listen {
    margin-top: clamp(1.75rem, 5vh, 3rem);
  }

  .listen h2 {
    margin-bottom: 1.1rem;
  }

  .buttons {
    display: grid;
    gap: 0.8rem;
  }

  @media (min-width: 48em) {
    .buttons {
      display: flex;
      flex-wrap: wrap;
    }

    .buttons .btn {
      width: auto;
      min-width: 11rem;
      padding-inline: 1.75rem;
    }
  }
</style>
