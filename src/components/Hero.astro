---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Player from './Player.astro';

const year = new Date(site.single.releaseDate).getFullYear();

const icons = {
  spotify:
    'M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.5 17.3c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14 4.32-1.32 9.72-.66 13.44 1.62.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z',
  apple:
    'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701',
  more: null,
} as const;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <figure class="hero-figure" data-reveal>
      <Image
        class="cover"
        src={site.single.cover}
        alt={`Portada del single "${site.single.title}" de ${site.artist}`}
        widths={[360, 480, 640, 800]}
        sizes="(min-width: 1200px) 560px, (min-width: 768px) 44vw, calc(100vw - 2.5rem)"
        priority
      />
      <figcaption class="caption">
        <span>“{site.single.title}”</span>
        <span>{year}</span>
      </figcaption>
    </figure>
    <div class="hero-body" data-reveal style="--reveal-delay: 0.1s">
      <p class="eyebrow">{site.artist}</p>
      <h1 id="hero-heading">“{site.single.title}”</h1>
      <p class="meta">Single · {year}</p>
      <h2 id="listen" class="section-head">
        <span class="num">01</span>Escúchala
      </h2>
      <div class="buttons">
        {
          site.listen.map((item) => (
            <a
              class:list={['btn', { 'btn-primary': item.platform === 'spotify' }]}
              href={item.url}
              target="_blank"
              rel="noopener"
            >
              {item.platform === 'more' ? (
                <svg
                  class="icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c2.8 2.6 2.8 15.4 0 18M12 3c-2.8 2.6-2.8 15.4 0 18" />
                </svg>
              ) : (
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={icons[item.platform]} />
                </svg>
              )}
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="player-wrap">
        <Player />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.25rem, 6vw, 5rem);
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
  }

  .hero-figure {
    margin: 0;
    padding: clamp(0.6rem, 1.2vw, 0.9rem);
    border: 1px solid var(--line-strong);
    background: var(--bg-raise);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
  }

  .caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .eyebrow {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--muted);
  }

  h1 {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-weight: 450;
    font-size: clamp(2.6rem, 8vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .meta {
    margin: 1.1rem 0 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  .hero-body .section-head {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .buttons {
    display: grid;
    gap: 0.75rem;
  }

  .player-wrap {
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .buttons {
      grid-template-columns: repeat(2, 1fr);
    }

    .buttons a:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 3rem 2rem;
      align-items: center;
    }

    .hero-figure {
      grid-column: 1 / 7;
    }

    .hero-body {
      grid-column: 7 / 13;
    }
  }

  @media (min-width: 1100px) {
    .hero-body {
      grid-column: 8 / 13;
    }
  }
</style>
