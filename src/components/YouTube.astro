---
import { site } from '../data/site';
---

<section aria-labelledby="youtube-heading">
  <h2 id="youtube-heading" class="section-head">
    <span class="num">03</span>Videos
  </h2>
  <div class="videos" data-reveal>
    {
      site.youtube.videoId ? (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${site.youtube.videoId}`}
          title={`Video de ${site.youtube.label}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <a class="card card-yt" href={site.youtube.url} target="_blank" rel="noopener">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
            />
          </svg>
          <span class="yt-text">
            <span class="yt-title">{site.youtube.label}</span>
            <span class="yt-sub">Ver canal</span>
          </span>
          <svg
            class="arrow"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14m0 0-6-6m6 6-6 6" />
          </svg>
        </a>
      )
    }
  </div>
</section>

<style>
  .videos iframe {
    display: block;
    width: 100%;
    max-width: 48rem;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 0.25rem;
    background: var(--bg-raise);
  }

  .card-yt {
    max-width: 48rem;
  }

  .yt-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .yt-title {
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.3;
  }

  .yt-sub {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
